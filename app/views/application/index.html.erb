<% if user_signed_in? %>
  <h2>Welcome, <%= current_user.name %></h2>

  <h2 id='others'>Others' lists</h2>
  <% current_user.family.users.each do |other_user| %>
    <% if other_user == current_user %>
      <% next %>
    <% end %>
    <h3><%= other_user.name %></h3>
    <% if other_user.items.empty? %>
      <p><i>This person hasn't made their list yet.</i></p>
    <% else %>
      <table class='table table-dark others-items-table'>
        <tr>
          <th class='item-priority-output-col'>Priority</th>
          <th class='item-name-output-col'>Name</th>
          <th class='item-price-output-col'>Price</th>
          <th class='item-description-output-col'>Description</th>
          <th class='item-link-output-col'>Link</th>
          <th class='item-output-purchase-col'>Bought?</th>
        </tr>
        <% other_user.items.each do |item| %>
          <tr <% if item.purchasers.include? current_user or (not item.plural? and not item.purchasers.empty?) %> class='table-warning' <% end %> >
            <%# Priority %>
            <td class='item-priority-output-col'>
              <p class='item-output'><%= item.priority %></p>
            </td>
            <%# Name %>
            <td class='item-name-output-col'>
              <p class='item-output'><%= item.name %></p>
            </td>
            <%# Price %>
            <td class='item-price-output-col'>
              <% if (not item.price.nil?) and (not item.price.empty?) %>
                <p class='item-output'>$<%= item.price %></p>
              <% end %>
            </td>
            <%# Description %>
            <td class='item-description-output-col'>
              <p class='item-output'><%= item.description %></p>
            </td>
            <%# Link %>
            <td data-sort-value='<% if item.has_link? %> 1 <% else %> 0 <% end %>' class='item-link-output-col'>
              <% if item.has_link? %>
                <%= link_to 'Link', item.link, target: '_blank', class: 'btn btn-info' %>
              <% end %>
            </td>
            <td data-sort-value='<%= item.purchase_sort_value current_user %>' class='item-output-purchase-col'>
              <% if item.plural? %>
                <p>It's ok if multiple people buy this item.</p>
              <% end %>
              <% if item.purchasers.include? current_user %>
                <p>You've decided to buy this item.</p>
                <%= button_to "Actually I've decided not to buy it", item_purchase_path(item, current_user.purchases.find_by(item: item)), method: :delete, class: 'btn btn-warning' %>
              <% elsif item.plural? or item.purchasers.empty? %>
                <%= button_to "I've decided to buy this item", item_purchases_path(item), method: :post, class: 'btn btn-primary' %>
              <% else %>
                <p>Someone else has already decided to buy this item.</p>
              <% end %>
              <% if item.purchasers.empty? %>
                <p>No one has decided to buy this item yet.</p>
              <% elsif item.plural? %>
                <% if item.purchasers.length == 1 and item.purchasers.first == current_user %>
                  <p>No one else has decided to buy this item yet.</p>
                <% else %>
                  <% item_count = item.purchasers.count {|us| us != current_user} %>
                  <p><strong><%= item_count %></strong> other <% if item_count == 1 %>person has<% else %>people have<% end %> decided to buy this item.</p>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
    <% end %>
  <% end %>

  <h2 id='you'>Your list</h2>
  <h3>Existing items</h3>
  <% if current_user.items.empty? %>
    <p><i>You don't have any items listed yet.</i></p>
  <% else %>
    <p>Only one item may be updated at a time.</p>
    <%# By the rules of HTML we can't have a form wrapping around or tucked just inside of one row of a table %>
    <%# So we make empty forms up here and individually connect the later inputs to them using form='' %>
    <% current_user.items.each do |item| %>
      <%# The namespace prevents, for example, all item name fields from having the same id and name %>
      <%= form_with model: item, id: dom_id(item, 'form'), class: 'd-none' do %>
      <% end %>
    <% end %>
    <table class='table table-dark your-items-table'>
      <tr>
        <th class='item-priority-input-col'>Priority</th>
        <th class='item-name-input-col'>Name (req)</th>
        <th class='item-price-input-col'>Price</th>
        <th class='item-description-input-col'>Description</th>
        <th class='item-link-input-col'>Link</th>
        <th class='item-plurality-input-col'>Plurality (req)</th>
        <th class='item-input-action-col'>Actions</th>
      </tr>
      <% current_user.items.each do |item| %>
        <tr>
          <%# Priority %>
          <td data-sort-value='<%= item.priority %>' class='item-priority-input-col'>
            <%= number_field_tag *item.tag_args(:priority), **item.tag_kwargs(:priority), min: 0, class: 'full-width' %>
          </td>
          <%# Name %>
          <td class='item-name-input-col'>
            <%= text_field_tag "item_#{item.id}[name]", item.send(:name), **item.tag_kwargs(:name), class: 'full-width' %>
          </td>
          <%# Price %>
          <td class='item-price-input-col'>
            <%# d-flex keeps the dollar sign next to the price input %>
            <div class='d-flex'>
              $&nbsp;<%= text_field_tag *item.tag_args(:price), **item.tag_kwargs(:price), class: 'full-width' %>
            </div>
          </td>
          <%# Description %>
          <td class='item-description-input-col'>
            <%= text_area_tag *item.tag_args(:description), **item.tag_kwargs(:description) %>
          </td>
          <%# Link %>
          <td class='item-link-input-col'>
            <%= text_area_tag *item.tag_args(:link), **item.tag_kwargs(:link), class: 'item-link-input' %>
          </td>
          <%# Plurality %>
          <td class='item-plurality-input-col'>
            <div class='form-check'>
              <%= radio_button_tag "item_#{item.id}[plural]", 'singular', !item.plural?, **item.tag_kwargs(:plural_singular), class: 'form-check-input' %>
              <%= label_tag "item_#{item.id}_plural_singular", 'If someone buys this for me, others should avoid buying another one', for: dom_id(item, 'plural_singular'), class: 'form-check-label' %>
            </div>
            <div class='form-check'>
              <%= radio_button_tag "item_#{item.id}[plural]", 'plural', item.plural?, **item.tag_kwargs(:plural_plural), class: 'form-check-input' %>
              <%= label_tag "item_#{item.id}_plural_plural", "It's ok if multiple people each buy me several of this item", for: dom_id(item, 'plural_plural'), class: 'form-check-label' %>
            </div>
          </td>
          <%# Actions %>
          <td class='item-input-action-col'>
            <table class='item-action-subtable'>
              <tr>
                <td>
                  <%= submit_tag 'Save', form: dom_id(item, 'form'), class: 'btn btn-success' %>
                </td>
              </tr>
              <tr>
                <td>
                  <%= button_to 'Delete', item, method: :delete, class: 'btn btn-danger', data: { turbo_confirm: "Delete #{item.name}?" } %>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      <% end %>
    </table>
  <% end %>

  <h3>New item</h3>
  <dl>
    <dt>Priorities</dt>
    <dd>Priorities are optional, and allow you to specify an adjustable default order for items to appear in (often indicating how much you want each item). Give the item you want most a priority of 1, the one you want second most a priority of 2, and so on. (It doesn't matter if you skip numbers.) Any items with no specified priority will appear below all items with a priority. If you don't give any of your items a priority, they will appear in the order you created them.</dd>
    <dt>Prices</dt>
    <dd>Prices are optional, and can be numbers (12.99), ranges (10 - 15, sorted as 12.50), or any other text.</dd>
  </dl>
  <%# The namespace prevents, for example, the item name field from having the same id or name as the name fields of existing items %>
  <%= form_with model: Item.new, namespace: 'new' do |f| %>
    <table class='table table-dark full-width'>
      <tr>
        <th class='item-priority-input-col'>Priority</th>
        <th class='item-name-input-col'>Name (req)</th>
        <th class='item-price-input-col'>Price</th>
        <th class='item-description-input-col'>Description</th>
        <th class='item-link-input-col'>Link</th>
        <th class='item-plurality-input-col'>Plurality (req)</th>
        <th class='item-input-action-col'>Save</th>
      </tr>
      <tr>
        <%# Priority %>
        <td class='item-priority-input-col'>
          <%= f.number_field :priority, min: 0, class: 'full-width' %>
        </td>
        <%# Name %>
        <td class='item-name-input-col'>
          <%= f.text_field :name, class: 'full-width' %>
        </td>
        <%# Price %>
        <td class='item-price-input-col'>
          <%# d-flex keeps the dollar sign next to the price input %>
          <div class='d-flex'>
            $&nbsp;<%= f.text_field :price, class: 'full-width' %>
          </div>
        </td>
        <%# Description %>
        <td class='item-description-input-col'>
          <%= f.text_area :description %>
        </td>
        <%# Link %>
        <td class='item-link-input-col'>
          <%= f.text_area :link, class: 'item-link-input' %>
        </td>
        <%# Plurality %>
        <td class='item-plurality-input-col'>
          <div class='form-check'>
            <%= f.radio_button :plural, 'singular', checked: true, class: 'form-check-input' %>
            <%= f.label :plural_singular, 'If someone buys this for me, others should avoid buying another one', class: 'form-check-label' %>
          </div>
          <div class='form-check'>
            <%= f.radio_button :plural, 'plural', class: 'form-check-input' %>
            <%= f.label :plural_plural, "It's ok if multiple people each buy me several of this item", class: 'form-check-label' %>
          </div>
        </td>
        <%# Save %>
        <td class='item-input-action-col'>
          <%= f.submit 'Save', class: 'btn btn-success' %>
        </td>
      </tr>
    </table>
  <% end %>

<% else %>
  <h2>Cooperative Surprise</h2>
  <p>Cooperative Surprise is website designed for managing the wishlists of families or friend groups who want to buy gifts for each other. Your family can use it for free, as described below.</p>

  <h3>Motivation</h3>
  <p>When a family wants to buy gifts for one another, the classic conundrum is that everyone buying gifts for you needs to coordinate to avoid buying duplicate gifts, but you don't want to spoil the surprise of what you're getting before you tear open the wrapping paper on Christmas morning. And you also likely want to make a list of what you'd like and share it with others. Without a platform designed for this purpose you'll have to resort to making a separate email chain or text thread for each person people in the family, since each one of them has to exclude the person who you're coordinating buying gifts for.</p>

  <h3>Demo video</h3>
  <iframe id='demo-video' src="https://www.youtube-nocookie.com/embed/hY0yf83PaNQ?si=-_asgGx-e1l3jeDJ" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>

  <h3>How it works</h3>
  <p>Cooperative Surprise solves this problem. Here's how it works:</p>
  <ol>
    <li><p>John registers himself, creates a new family, and is given this family code: <code>zsmcqaaknk</code></p></li>
    <li><p>He then sends this code to his family members, Rose and Dave. Each of them enters the family code when they register, so they join the family that John created.</p></li>
    <li><p>Now John can create and update his own wishlist, visible to Rose and Dave. For each of his items he specifies whether he wants only one of the item or multiple.</p></li>
    <li><p>When Rose buys something for Dave, John can see that the item has been bought (but not who bought it), so he knows not to buy it (unless Dave indicated he wanted multiple of that item, which John can see). But when Rose buys something for John, John has no idea.</p></li>
  </ol>

  <h3>Features</h3>
  <ul>
    <li><p>When you're deciding what to buy for others, items that have already been bought for them appear in red. You can sort others' wishlists to see all unbought items at the top, or sort them by price.</p></li>
    <li><p>Items have an optional link field, so when you want a very particular limited edition of your favorite indie artist's new album (and you just know whoever buys it for you will get the wrong one) you can remove all the guess work and give your family members a link straight to the correct item.</p></li>
    <li><p>If you want to you can specify a custom ordering for your items, to rank them based on what you want most.</p></li>
    <li><p>You won't accidentally spoil yourself by visiting the wrong page or clicking the wrong link, because the pages where your family members see what has been bought for you are protected by their own individual passwords.</p></li>
  </ul>
  <p>Cooperative Surprise is most useful at times like Christmas when everyone is buying for everyone, but it also works well for birthdays, and as a way to build your wishlist over time (for people who have trouble making one off the top of their heads).</p>

<% end %>
