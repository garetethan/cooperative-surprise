<% if user_signed_in? %>
  <h1>Wishlist Manager</h1>
  <h2>Welcome, <%= current_user.name %></h2>
  <h2 id='others'>Others' lists</h2>
  <% current_user.family.users.each do |other_user| %>
    <% if other_user == current_user %>
      <% next %>
    <% end %>
    <h3><%= other_user.name %></h3>
    <% if other_user.items.empty? %>
      <p><i>This person hasn't made their list yet.</i></p>
    <% else %>
      <table class='table table-dark'>
        <tr>
          <th class='sortable-column item-name-output-col'>Name</th>
          <th class='sortable-column item-price-output-col'>Price</th>
          <th class='item-description-output-col'>Description</th>
          <th class='item-link-output-col'>Link</th>
          <th class='sortable-column item-output-purchase-col'>Bought?</th>
        </tr>
        <% other_user.items.each do |item| %>
          <tr <% if item.purchasers.include? current_user or (not item.plural? and not item.purchasers.empty?) %> class='table-warning' <% end %> >
            <%# Name %>
            <td class='item-name-output-col'>
              <p class='item-output'><%= item.name %></p>
            </td>
            <%# Price %>
            <td class='item-price-output-col'>
              <p class='item-output'>$<%= item.price %></p>
            </td>
            <%# Description %>
            <td class='item-description-output-col'>
              <p class='item-output description'><%= item.description %></p>
            </td>
            <%# Link %>
            <td class='item-link-output-col'>
              <% if not item.link.nil? and not item.link.empty? %>
                <%= link_to 'Link', item.link, target: '_blank', class: 'btn btn-info' %>
              <% end %>
            </td>
            <td class='item-output-purchase-col'>
              <% if item.plural? %>
                <p>This item may be bought multiple times by multiple people.</p>
              <% end %>
              <% if item.purchasers.include? current_user %>
                <p>You bought this item.</p>
                <%= button_to "Actually I didn't buy it", item_purchase_path(item, current_user.purchases.find_by(item: item)), method: :delete, class: 'btn btn-warning' %>
              <% elsif item.plural? or item.purchasers.empty? %>
                <%= button_to 'I bought this item', item_purchases_path(item), method: :post, class: 'btn btn-primary' %>
              <% else %>
                <p>Someone else already bought this item.</p>
              <% end %>
              <% if item.plural? %>
                <% if item.purchasers.empty? %>
                  <p>No one has bought this item yet.</p>
                <% elsif item.purchasers.length == 1 and item.purchasers.first == current_user %>
                  <p>No one else has bought this item yet.</p>
                <% else %>
                  <% item_count = item.purchasers.count {|us| us != current_user} %>
                  <p><strong><%= item_count %></strong> other <% if item_count == 1 %>person has<% else %>people have<% end %> already bought this item.</p>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </table>
    <% end %>
  <% end %>
  <h2 id='you'>Your list</h2>
  <h3>Existing items</h3>
  <% if current_user.items.empty? %>
    <p><i>You don't have any items listed yet.</i></p>
  <% else %>
    <%# By the rules of HTML we can't have a form wrapping around or tucked just inside of one row of a table %>
    <%# So we make empty forms up here and individually connect the later inputs to them using form='' %>
    <% current_user.items.each do |item| %>
      <%# The namespace prevents, for example, all item name fields from having the same id and name %>
      <%= form_with model: item, id: dom_id(item, 'form'), class: 'd-none' do %>
      <% end %>
    <% end %>
    <table class='table table-dark'>
      <tr>
        <th class='item-name-input-col'>Name</th>
        <th class='item-price-input-col'>Price</th>
        <th class='item-description-input-col'>Description</th>
        <th class='item-link-input-col'>Link</th>
        <th class='item-plurality-input-col'>Plurality</th>
        <th class='item-input-action-col'>Actions</th>
      </tr>
      <% current_user.items.each do |item| %>
        <tr>
          <%# Name %>
          <td rowspan='2' class='item-name-input-col'>
            <%= text_field_tag "item_#{item.id}[name]", item.send(:name), **item.tag_kwargs(:name), class: 'full-width' %>
          </td>
          <%# Price %>
          <td rowspan='2' class='item-price-input-col'>
            <%# d-flex keeps the dollar sign next to the price input %>
            <div class='d-flex'>
              $&nbsp;<%= text_field_tag *item.tag_args(:price), **item.tag_kwargs(:price), class: 'full-width' %>
            </div>
          </td>
          <%# Description %>
          <td rowspan='2' class='item-description-input-col'>
            <%= text_area_tag *item.tag_args(:description), **item.tag_kwargs(:description) %>
          </td>
          <%# Link %>
          <td rowspan='2' class='item-link-input-col'>
            <%= text_area_tag *item.tag_args(:link), **item.tag_kwargs(:link), class: 'item-link-input' %>
          </td>
          <%# Plurality %>
          <td rowspan='2' class='item-plurality-input-col'>
            <div class='form-check'>
              <%= radio_button_tag "item_#{item.id}[plural]", 'singular', !item.plural?, **item.tag_kwargs(:plural_singular), class: 'form-check-input' %>
              <%= label_tag "item_#{item.id}_plural_singular", 'If someone buys this for me, others should avoid buying another one', for: dom_id(item, 'plural_singular'), class: 'form-check-label' %>
            </div>
            <div class='form-check'>
              <%= radio_button_tag "item_#{item.id}[plural]", 'plural', item.plural?, **item.tag_kwargs(:plural_plural), class: 'form-check-input' %>
              <%= label_tag "item_#{item.id}_plural_plural", "It's ok if multiple people each buy me several of this item", for: dom_id(item, 'plural_plural'), class: 'form-check-label' %>
            </div>
          </td>
          <%# Actions %>
          <td class='item-input-action-col'>
            <%= submit_tag 'Save', form: dom_id(item, 'form'), class: 'btn btn-success' %>
          </td>
        </tr>
        <tr>
          <td>
            <%= button_to 'Delete', item, method: :delete, class: 'btn btn-danger', data: { turbo_confirm: "Delete #{item.name}?" } %>
          </td>
        </tr>
      <% end %>
    </table>
  <% end %>
  <h3>New item</h3>
  <%# The namespace prevents, for example, the item name field from having the same id or name as the name fields of existing items %>
  <%= form_with model: Item.new, namespace: 'new' do |f| %>
    <table class='table table-dark full-width'>
      <tr>
        <th class='item-name-input-col'>Name</th>
        <th class='item-price-input-col'>Price</th>
        <th class='item-description-input-col'>Description</th>
        <th class='item-link-input-col'>Link</th>
        <th class='item-plurality-input-col'>Plurality</th>
        <th class='item-input-action-col'>Save</th>
      </tr>
      <tr>
        <%# Name %>
        <td class='item-name-input-col'>
          <%= f.text_field :name, class: 'full-width' %>
        </td>
        <%# Price %>
        <td class='item-price-input-col'>
          <%# d-flex keeps the dollar sign next to the price input %>
          <div class='d-flex'>
            $&nbsp;<%= f.text_field :price, class: 'full-width' %>
          </div>
        </td>
        <%# Description %>
        <td class='item-description-input-col'>
          <%= f.text_area :description %>
        </td>
        <%# Link %>
        <td class='item-link-input-col'>
          <%= f.text_area :link, class: 'item-link-input' %>
        </td>
        <%# Plurality %>
        <td class='item-plurality-input-col'>
          <div class='form-check'>
            <%= f.radio_button :plural, 'singular', checked: true, class: 'form-check-input' %>
            <%= f.label :plural_singular, 'If someone buys this for me, others should avoid buying another one', class: 'form-check-label' %>
          </div>
          <div class='form-check'>
            <%= f.radio_button :plural, 'plural', class: 'form-check-input' %>
            <%= f.label :plural_plural, "It's ok if multiple people each buy me several of this item", class: 'form-check-label' %>
          </div>
        </td>
        <%# Save %>
        <td class='item-input-action-col'>
          <%= f.submit 'Save', class: 'btn btn-success' %>
        </td>
      </tr>
    </table>
  <% end %>
<% else %>
  <h1>Cooperative Surprise</h1>
  <p>Cooperative Surprise is a wishlist manager designed to be used by family members buying gifts for each other. You can create your own wishlist, and everyone except you can mark items they've bought and see what others have already bought. Likewise, you can see what your family members have asked for, and mark off what you buy.</p>
<% end %>
