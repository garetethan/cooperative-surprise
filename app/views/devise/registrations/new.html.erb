<h2>Sign up</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <p><%= f.label 'New or existing family?' %></p>
    <div class='form-check'>
      <%# The :checked value maintains the user's previous selection if the form is being reloaded after a failed submission %>
      <%= f.radio_button :family_status, 'new', checked: @user.family_status == 'new', data: { action: 'new-family' }, class: 'form-check-input' %>
      <%= f.label :family_status_new, 'Create a new family', class: 'form-check-label' %>
    </div>
    <div class='form-check'>
      <%# The :checked comparison intentionally includes family_status == nil when the form first loads %>
      <%= f.radio_button :family_status, 'existing', checked: @user.family_status != 'new', data: { action: 'existing-family' }, class: 'form-check-input' %>
      <%= f.label :family_status_existing, 'Join an existing family', class: 'form-check-label' %>
    </div>
    <p>If a family member of yours has asked you to sign-up, you should join their family instead of creating a new one.</p>
  </div>

  <%# The family code field is initially shown, but hidden by JS if "Join an existing family" is selected above %>
  <div id='family-code-field' class='field'>
    <p><%= f.label :family_code %></p>
    <p><%= f.text_field :family_code, value: params[:family] %></p>
    <p>Family IDs are ten-letter random-looking case-insensitive codes. If a family member of yours asked you to sign-up, they should also have sent you the code to enter here.</p>
  </div>

  <%# The family name field is initially hidden, but shown by JS if "Create a new family" is selected above %>
  <div id='family-name-field' class='field d-none'>
    <p><%= f.label :family_name %></p>
    <p><%= f.text_field :family_name %></p>
    <p>Your family members should recognize this name so that they know when they've joined the family successfully. Your family's last name (or the last name of your common ancestor) would be a good choice.</p>
  </div>

  <div class="field">
    <p><%= f.label :name, 'Your name' %></p>
    <p><%= f.text_field :name %></p>
    <p>This is the name other family members will see to identify you. It should be different than any one else's in your family.</p>
  </div>

  <div class="field">
    <p><%= f.label :email %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password %></p>
    <% if @minimum_password_length %>
      <p><em>(<%= @minimum_password_length %> characters minimum)</em></p>
    <% end %>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>
    <p>This password is just for you. Don't share it with your family members.</p>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit 'Sign up', class: 'btn btn-primary' %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
