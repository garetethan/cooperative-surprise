<!DOCTYPE html>
<html lang='en'>
  <head>
    <title><%= content_for(:title) || "Cooperative Surprise" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class='alert alert-danger <% if not alert %> d-none <% end %>' role='alert'><%= alert %></div>
    <div class='alert alert-success <% if not notice %> d-none <% end %>' role='alert'><%= notice %></div>
    <% if user_signed_in? %>
        <nav>
          <%= link_to 'Home', root_path %>
          <%= link_to 'User settings', edit_user_registration_path %>
          <% if current_user.administered_family %>
            <%= link_to 'Family settings', edit_family_path %>
          <% end %>
          <%= link_to 'Sign out', destroy_user_session_path, data: { turbo_method: :delete } %>
        </nav>
    <% end %>
    <%= yield %>
  </body>
</html>
