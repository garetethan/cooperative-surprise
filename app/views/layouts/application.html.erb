<!DOCTYPE html>
<html lang='en'>
  <head>
    <title><%= content_for(:title) || "Cooperative Surprise" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%# Bootstrap %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <%# There's another Javascript library named SourTable at app/javascript/sourtable.js (imported into app/javascript/application.js) for wishlist table sorting %>
    <%# It injects its own CSS %>
    <%# https://sid-the-sloth1.github.io/docs/sourTable.html %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if alert %>
      <div class='alert alert-danger' role='alert'>
        <% if alert.has_key? 'list' %>
          <p><%= alert['lead'] %>:</p>
          <ul>
            <% alert['list'].each do | item | %>
              <li><%= item %></li>
            <% end %>
          </ul>
        <% else %>
          <p><%= alert['lead'] %></p>
        <% end %>
      </div>
    <% end %>
    <% if notice %>
      <div class='alert alert-success' role='alert'><%= notice %></div>
    <% end %>
    <% if devise_controller? and resource.errors.any? %>
      <div class='alert alert-danger' role='alert'><%= render 'devise/shared/error_messages', resource: resource %></div>
    <% end %>
    <nav class='navbar navbar-expand-sm bg-body-tertiary' data-bs-theme='dark'>
      <div class='container-fluid'>
        <button class='navbar-toggler' data-bs-toggle='collapse' data-bs-target='#navbar-content' aria-controls='navbar-content' aria-expanded='false' aria-label='Toggle navigation'>
          <span class='navbar-toggler-icon'></span>
        </button>
        <div class='collapse navbar-collapse justify-content-between' id='navbar-content'>
          <ul class='navbar-nav'>
            <li class='nav-item'>
              <%= link_to 'Home', root_path, class: 'nav-link' %>
            </li>
            <% if user_signed_in? %>
              <li class='nav-item'>
                <%= link_to 'User settings', edit_user_registration_path, class: 'nav-link' %>
              </li>
              <% if current_user.administered_family %>
                <li class='nav-item'>
                  <%= link_to 'Family settings', edit_family_path, class: 'nav-link' %>
                </li>
              <% end %>
            <% else %>
              <li class='nav-item'>
                <%= link_to 'Sign up', new_user_registration_path, class: 'nav-link' %>
              </li>
            <% end %>
          </ul>
          <ul class='navbar-nav'>
            <% countdown_start = Date.new(Date.current.year, 11, 15) %>
            <% christmas = Date.new(Date.current.year, 12, 25) %>
            <% if Date.current >= countdown_start %>
              <%# For some reason subtracting dates gives a fraction, so conversion to integer is necessary %>
              <li class='nav-item'><span class='nav-text christmas-countdown'>
                <% if Date.current < christmas %>
                  Christmas countdown: <%= (christmas - Date.current).to_i %> days
                <% elsif Date.current == christmas %>
                  Merry Christmas!
                <% end %>
              </span></li>
            <% end %>

            <% if user_signed_in? %>
              <li class='nav-item'><span class='nav-text'><%= current_user.family.name %> family</span></li>
              <li class='nav-item'>
                <%= link_to 'Log out', destroy_user_session_path, data: { turbo_method: :delete }, class: 'btn btn-outline-danger session-button' %>
              </li>
            <% else %>
              <li class='nav-item'>
                <%= link_to 'Log in', new_user_session_path, class: 'btn btn-outline-success session-button' %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>
    <div class='container-fluid'>
      <%= yield %>
    </div>
  </body>
</html>
